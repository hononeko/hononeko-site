{
  "name": "hononeko-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:sshx": "wrangler dev --host sshx.hononeko.app",
    "dev:doppel": "wrangler dev --host doppel.hononeko.app",
    "test": "bun test",
    "check": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text"
  },
  "devDependencies": {
    "wrangler": "4.155.0"
  },
  "packageManager": "bun@1.4.4"
}
